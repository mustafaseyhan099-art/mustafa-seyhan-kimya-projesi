style>
#turkiyeMap.tr-fullscreen{position:fixed;inset:0;z-index:99999;max-width:none;margin:0;padding:0;overflow:auto;background:#091229}
body.tr-map-open{overflow:hidden}
#turkiyeMap.tr-fullscreen .tr-map-shell{min-height:100vh;border-radius:0;border:0;max-width:none;padding:16px 24px}
#turkiyeMap.tr-fullscreen .tr-map-layout{display:flex;flex-direction:column;gap:8px}
#turkiyeMap.tr-fullscreen .tr-map-canvas{width:100%;max-width:none}
#turkiyeMap.tr-fullscreen #trMapSvg{display:block;width:100%;height:auto;max-height:62vh;aspect-ratio:800/390;object-fit:contain}
#turkiyeMap.tr-fullscreen .tr-map-info{width:100%;max-width:none;min-height:70px}
#trFamilyLegend{display:flex;gap:9px;flex-wrap:wrap;margin:10px 0;font-size:12px}
#trFamilyLegend span{display:inline-flex;gap:5px;align-items:center}
#trFamilyLegend i{display:inline-block;width:12px;height:12px;border-radius:3px}
#trExtras{margin-top:20px}
#trExtras h3{margin-bottom:4px}
.tr-extra-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px;margin:12px 0}
.tr-extra-element{display:flex;flex-direction:column;align-items:flex-start;gap:5px;border:1px solid var(--element-color);border-left:6px solid var(--element-color);background:#152443;color:#fff;border-radius:9px;padding:10px;cursor:pointer}
.tr-extra-element:hover{background:#29436d}
.tr-extra-element span{font-size:12px}
#trFull{margin-left:auto}
@media(max-width:700px){#turkiyeMap.tr-fullscreen .tr-map-shell{padding:12px}#turkiyeMap.tr-fullscreen #trMapSvg{height:auto;max-height:43vh}}
</style><style id="true-map-fullscreen">
/* Harita modu: haritanın kendisi tüm ekranı doldurur. */
#turkiyeMap.tr-fullscreen{padding:0!important;width:100vw!important;height:100dvh!important;overflow:hidden!important}
#turkiyeMap.tr-fullscreen .tr-map-shell{position:relative;box-sizing:border-box;width:100%;height:100%;min-height:0!important;padding:0!important;display:block;overflow:hidden;background:#091229}
#turkiyeMap.tr-fullscreen .tr-map-shell>h2,#turkiyeMap.tr-fullscreen #trMapIntro,#turkiyeMap.tr-fullscreen #trFamilyLegend,#turkiyeMap.tr-fullscreen .tr-map-caption,#turkiyeMap.tr-fullscreen .tr-map-actions{display:none!important}
#turkiyeMap.tr-fullscreen .tr-map-layout{position:absolute!important;inset:0!important;display:block!important;margin:0!important;padding:0!important}
#turkiyeMap.tr-fullscreen .tr-map-canvas{position:absolute!important;inset:0!important;box-sizing:border-box;width:100%!important;height:100%!important;max-width:none!important;min-height:0!important;border:0!important;border-radius:0!important;display:flex!important;align-items:center!important;justify-content:center!important;background:#091229}
#turkiyeMap.tr-fullscreen #trMapSvg{width:100%!important;height:100%!important;max-height:none!important;max-width:none!important;aspect-ratio:auto!important;object-fit:contain!important;display:block!important;flex:1;min-height:0}
#turkiyeMap.tr-fullscreen .tr-map-tabs{position:absolute;top:12px;left:12px;z-index:4;margin:0!important;gap:5px;max-width:calc(100% - 24px)}
#turkiyeMap.tr-fullscreen .tr-map-tabs button{padding:8px 10px;font-size:12px;background:#0b1738eb}
#turkiyeMap.tr-fullscreen #trMapSearch{position:absolute;top:60px;left:12px;z-index:4;max-width:min(270px,calc(100% - 24px));background:#0b1738ef}
#turkiyeMap.tr-fullscreen .tr-map-info{position:absolute;bottom:10px;left:12px;right:12px;z-index:3;box-sizing:border-box;width:auto!important;max-width:540px!important;min-height:0!important;max-height:24vh;overflow:auto;padding:10px 14px;background:#0b1738ec}
#turkiyeMap.tr-fullscreen .tr-map-info h3{font-size:15px;margin:0 0 4px}#turkiyeMap.tr-fullscreen .tr-map-info p{margin:3px 0;font-size:12px}
#turkiyeMap.tr-fullscreen #trExtras{display:none!important}
#turkiyeMap.tr-fullscreen .tr-map-canvas svg text{paint-order:stroke}
@media(max-width:700px){#turkiyeMap.tr-fullscreen .tr-map-tabs{top:6px;left:6px}#turkiyeMap.tr-fullscreen .tr-map-tabs button{padding:6px;font-size:10px}#turkiyeMap.tr-fullscreen #trMapSearch{top:45px;left:6px;padding:7px}#turkiyeMap.tr-fullscreen .tr-map-info{bottom:5px;left:5px;right:5px;max-height:19vh}}
</style><style id="map-v3-polish">
#turkiyeMap.tr-fullscreen .tr-map-tabs{top:10px;left:12px;right:12px;justify-content:flex-start;pointer-events:none}
#turkiyeMap.tr-fullscreen .tr-map-tabs button{pointer-events:auto;box-shadow:0 0 12px #00b7ff30}
#turkiyeMap.tr-fullscreen #trMapSearch{top:auto!important;left:auto!important;right:18px!important;bottom:22px!important;width:min(330px,35vw)!important;max-width:unset!important;border:1px solid #3cbaff!important;box-shadow:0 0 16px #00b7ff38}
#turkiyeMap.tr-fullscreen .tr-map-info{bottom:20px!important;left:18px!important;right:auto!important;width:min(450px,40vw)!important;max-width:none!important;max-height:29vh!important;border:1px solid #4cbcff!important;box-shadow:0 0 20px #00aaff33}
#turkiyeMap.tr-fullscreen .tr-map-canvas{padding:30px 8px 65px;box-sizing:border-box}
#turkiyeMap.tr-fullscreen .tr-map-canvas svg{overflow:visible}
.tr-province{transition:opacity .18s ease}
.tr-province:hover path{stroke:#fff!important;stroke-width:1.7!important;filter:drop-shadow(0 0 3px #8af3ff)}
.tr-province.selected path{filter:drop-shadow(0 0 3px #fff9a8) drop-shadow(0 0 9px #ffbd36);animation:provincePulse 1.6s ease-in-out infinite;stroke:#fff7a8!important}
.tr-province.selected text{fill:#fff!important;stroke:#1b2142!important;stroke-width:1.1!important}
@keyframes provincePulse{0%,100%{filter:drop-shadow(0 0 2px #fff1a4) drop-shadow(0 0 5px #ffc64d)}50%{filter:drop-shadow(0 0 6px #fff7be) drop-shadow(0 0 14px #ffb400)}}
@media(max-width:700px){#turkiyeMap.tr-fullscreen #trMapSearch{bottom:12px!important;right:8px!important;width:44vw!important}#turkiyeMap.tr-fullscreen .tr-map-info{bottom:12px!important;left:8px!important;width:49vw!important;max-height:23vh!important}#turkiyeMap.tr-fullscreen .tr-map-canvas{padding:45px 0 80px}}
</style><style id="offline-map-style">
#turkiyeMap.tr-fullscreen{background:radial-gradient(ellipse at 55% 50%,#132c4b 0%,#061020 82%)!important}
#turkiyeMap.tr-fullscreen .tr-map-canvas{background:transparent!important}
#turkiyeMap.tr-fullscreen #trMapSvg{width:100%!important;height:100%!important;max-width:100%!important;display:block!important}
#turkiyeMap .tr-province{isolation:isolate}
#turkiyeMap .tr-province path{transition:stroke .2s,stroke-width .2s,filter .2s}
#turkiyeMap .tr-province:hover path{filter:brightness(1.3) drop-shadow(0 0 2px #75d8ff)}
#turkiyeMap .tr-province.selected path{stroke:#fff2a5!important;stroke-width:3.2!important;filter:drop-shadow(0 0 5px #ffd34e) drop-shadow(0 0 11px #ff9e23)!important;animation:provincePulse 1.6s ease-in-out infinite alternate}
@keyframes provincePulse{from{filter:drop-shadow(0 0 3px #ffd34e) drop-shadow(0 0 6px #ff9e23)}to{filter:drop-shadow(0 0 9px #fff5b2) drop-shadow(0 0 16px #ffd000)}}
#turkiyeMap .tr-province text{pointer-events:none;stroke:#f5fbff;stroke-width:1.05;paint-order:stroke;font-family:system-ui,Arial;font-weight:900}
#turkiyeMap.tr-fullscreen #trMapSearch{left:auto!important;right:16px!important;top:auto!important;bottom:20px!important;max-width:min(340px,calc(100% - 32px))!important;width:340px!important;z-index:9!important;padding:13px 15px!important}
#turkiyeMap.tr-fullscreen .tr-map-info{left:16px!important;right:auto!important;bottom:20px!important;max-width:min(390px,calc(100% - 36px))!important;background:#071934f1!important;border:1px solid #58bef4!important}
#turkiyeMap.tr-fullscreen .tr-map-tabs{top:12px!important;left:16px!important;right:auto!important}
#turkiyeMap.tr-fullscreen #trExtras{display:none!important}
#turkiyeMap .tr-map-info button{background:#2563a7;color:white;border:1px solid #8ecdf8;padding:8px 12px;border-radius:8px;cursor:pointer}
@media(max-width:700px){#turkiyeMap.tr-fullscreen #trMapSearch{right:8px!important;bottom:10px!important;width:45%!important;font-size:12px!important}#turkiyeMap.tr-fullscreen .tr-map-info{left:8px!important;bottom:10px!important;width:50%!important;max-width:50%!important;max-height:28vh!important}#turkiyeMap.tr-fullscreen .tr-map-tabs{left:8px!important}}
</style><style id="turkiye-map-bottom-panels-swap">
/* Map full screen: bottom left search, bottom right selected element data */
#turkiyeMap.tr-fullscreen #trMapSearch{
 left:16px!important;right:auto!important;top:auto!important;bottom:20px!important;
 width:min(350px,34vw)!important;max-width:calc(100vw - 32px)!important;
 z-index:10!important;
}
#turkiyeMap.tr-fullscreen .tr-map-info{
 left:auto!important;right:16px!important;top:auto!important;bottom:20px!important;
 width:min(400px,36vw)!important;max-width:calc(100vw - 32px)!important;
 z-index:10!important;
}
@media(max-width:700px){
 #turkiyeMap.tr-fullscreen #trMapSearch{
  left:8px!important;right:auto!important;bottom:9px!important;
  width:44vw!important;max-width:44vw!important;
 }
 #turkiyeMap.tr-fullscreen .tr-map-info{
  left:auto!important;right:8px!important;bottom:9px!important;
  width:49vw!important;max-width:49vw!important;max-height:28vh!important;
 }
}
</style></head><body class="home-mode"><select id="languagePicker" aria-label="Language / Dil"><option value="tr">🇹🇷 Türkçe</option><option value="en">🇬🇧 English</option><option value="de">🇩🇪 Deutsch</option><option value="fr">🇫🇷 Français</option><option value="ru">🇷🇺 Русский</option><option value="zh">🇨🇳 中文</option></select><div class="creator-credit">MUHAMMED MUSTAFA SEYHAN YAPMIŞTIR</div><header><div><h1>⚛ ATOM <span>LAB 3D</span></h1><div class="sub">Atom modelleri • Bilim insanları • Deneyler • Etkileşimli bilim atlası</div></div><div class="row"><button class="nav-btn" id="goHome" type="button">⌂ Ana sayfa</button><div class="sub">Çevrimdışı 3D motor · Harici kütüphane yok</div></div></header><section class="home" id="home"><div class="home-wrap"><div><div class="eyebrow">İNTERAKTİF BİLİM ATLASI</div><h2>Atomun <span>görünmeyen</span> dünyasını keşfet.</h2><p>Antik atom düşüncesinden modern kuantum kuramına uzanan bilim yolculuğuna katıl. Modelleri 3D döndür, 118 elementi incele, bilim insanlarının hayatlarını ve deneylerini öğren.</p><div class="home-actions"><button class="primary" id="startLab" type="button">⚛ 3D laboratuvara gir →</button><button class="secondary" id="startElements" type="button">118 elementi keşfet</button></div><div class="home-stats"><span><strong>118</strong> element</span><span><strong>14</strong> tarihsel yaklaşım</span><span><strong>3D</strong> etkileşimli deneyim</span></div></div><div class="hero-art" aria-hidden="true"><div class="hero-orbit"></div><div class="hero-orbit"></div><div class="hero-orbit"></div><div class="hero-core"></div></div></div></section><main><aside class="panel models"><h2>Atom modelleri</h2><div id="menu"></div></aside><section class="panel"><h2 id="modelName">3D Atom</h2><div class="stage" id="stage"><canvas id="canvas"></canvas><div class="stage-info"><strong id="stageLabel">Atom modeli</strong><div class="mini">Sürükle: döndür · Tekerlek: yakınlaş</div></div></div><div class="controls"><button class="action" id="play">⏸ Animasyonu durdur</button><button class="action" id="reset">↺ Görünümü sıfırla</button><button class="action" id="labels">● Parçacık isimleri</button></div><div class="row"><label>Hız <input id="speed" type="range" min="0" max="200" value="65"></label><label>Element (118) <select id="element"></select></label></div><p id="notice" class="mini">✓ Çizim motoru hazır. 3D modeller doğrudan bu dosyada çiziliyor.</p><div class="mini">Modeller ölçekli atom fotoğrafları değildir. Eski modeller tarihsel düşünceleri; modern orbital görünümü olasılık yoğunluğunu temsil eder.</div></section><aside class="panel details"><div id="facts"></div></aside></main><section class="timeline"><div class="panel"><h2>Atom teorisinin gelişimi</h2><p class="bodytext">Atom fikri antik felsefeden doğdu. Dalton deneysel kimyaya dayalı atom kuramını kurdu. Thomson elektronun varlığını gösterdi. Rutherford atom çekirdeğini ortaya koydu. Bohr belirli enerji düzeylerini kullandı. Sommerfeld modeli genişletti; de Broglie, Heisenberg, Schrödinger, Born ve Pauli kuantum yaklaşımını geliştirdi. Chadwick nötronu keşfetti. Her yeni açıklama, önceki modelin açıklayamadığı deneysel bulgulara yanıt verdi.</p><h3>Kaynaklar</h3><p class="source"><a href="https://www.alloprof.qc.ca/en/students/vl/sciences/the-history-of-the-atomic-model-s1109" target="_blank" rel="noopener">Alloprof – Atom modelleri tarihi</a> · <a href="https://www.creative-chemistry.org.uk/gcse/keyideas/atomic-structure/atomic-model" target="_blank" rel="noopener">Creative Chemistry – Atom yapısının gelişimi</a> · <a href="https://www.britannica.com/science/atom" target="_blank" rel="noopener">Encyclopaedia Britannica – Atom</a> · <a href="https://www.nobelprize.org/" target="_blank" rel="noopener">Nobel Prize – Bilim insanları</a></p></div></section><section class="tr-map-section" id="turkiyeMap"><div class="tr-map-shell"><h2 id="trMapHeading">🇹🇷 Türkiye Bilim Haritası</h2><p id="trMapIntro">81 ilin plaka numaraları 1–81 arasındaki elementlerin atom numaralarıyla eşleşir. Aynı element grubundaki iller aynı renktedir. 82–118 numaralı elementler aşağıdadır.</p><div class="tr-map-tabs"><button type="button" id="trTabElements" class="active">⚛ 118 Element</button><button type="button" id="trTabCities">📍 81 İl</button></div><input id="trMapSearch" class="tr-map-search" type="search" placeholder="Element ara: Fe, Demir, 26…" aria-label="Haritada ara"><div class="tr-map-layout"><div class="tr-map-canvas"><svg id="trMapSvg" viewBox="0 0 900 315" role="img" aria-label="Türkiye siluetinde elementler ve iller"><defs><clipPath id="trClip"><polygon points="42,142 52,115 82,109 107,93 136,97 158,82 187,88 205,75 232,86 263,80 288,94 321,85 354,93 378,76 405,81 435,94 461,88 488,100 514,88 540,101 574,95 599,107 627,96 655,106 680,98 704,110 731,107 759,121 780,115 808,131 832,126 855,146 849,167 829,174 810,190 792,185 770,207 748,207 727,225 703,220 682,240 657,231 632,244 606,234 585,251 555,239 531,250 505,238 482,248 459,230 431,243 409,231 381,240 352,228 327,236 303,223 276,234 253,218 226,226 206,206 179,211 163,193 140,201 121,182 103,186 86,168 63,170"/></clipPath></defs><polygon points="42,142 52,115 82,109 107,93 136,97 158,82 187,88 205,75 232,86 263,80 288,94 321,85 354,93 378,76 405,81 435,94 461,88 488,100 514,88 540,101 574,95 599,107 627,96 655,106 680,98 704,110 731,107 759,121 780,115 808,131 832,126 855,146 849,167 829,174 810,190 792,185 770,207 748,207 727,225 703,220 682,240 657,231 632,244 606,234 585,251 555,239 531,250 505,238 482,248 459,230 431,243 409,231 381,240 352,228 327,236 303,223 276,234 253,218 226,226 206,206 179,211 163,193 140,201 121,182 103,186 86,168 63,170" fill="#183b60" stroke="#71cfff" stroke-width="3" stroke-linejoin="round"/><g id="trMapItems"></g></svg></div><div class="tr-map-info" id="trMapInfo" aria-live="polite"><h3>⚛ Elementleri keşfet</h3><p>Haritadaki bir elemente tıkla. Atom numarasını, element grubunu ve parçacıklarını gör.</p></div></div><div class="tr-map-actions"><button id="trMapToLab" type="button">⚛ 3D Laboratuvar</button><button id="trMapHome" type="button">⌂ Ana sayfa</button></div><p class="tr-map-caption" id="trMapNote">Gerçek il sınırları kullanılır. Plaka–element eşleştirmesi eğitim amaçlıdır; maden dağılımını göstermez. Harita sınırları bu HTML dosyasının içindedir; çevrimdışı çalışır.</p></div></section><section class="activity-entry" id="activity" hidden aria-hidden="true"><div class="activity-card"><h2 id="activityTitle">🐸 Etkinlik: Bilge Kurbağa ile Atom Yarışması</h2><p id="activityDesc">Kurbağa sana atom modelleri, bilim insanları ve elementler hakkında dört şıklı sorular soracak. Her soruda 2 dakikan var!</p><button type="button" class="activity-launch" id="openQuiz">🐸 Etkinliğe Başla →</button></div></section>
<div class="quiz-overlay" id="quizOverlay" hidden role="dialog" aria-modal="true" aria-labelledby="quizTitle"><div class="tv-arena"><div class="tv-backdrop"></div><button type="button" class="quiz-close" id="closeQuiz" aria-label="Kapat">✕ Çıkış</button><div class="tv-heading" id="quizTitle">ATOM LAB 3D • QUIZ</div><button type="button" id="crowdSoundToggle" aria-pressed="true" class="tv-sound">🔊 Seyirci sesi: Açık</button><div class="tv-player tv-left"><small>⭐ SEN</small><strong id="playerPodium">0</strong></div><div class="tv-player tv-right"><small>🐸 KURBAĞA</small><strong id="frogPodium">0</strong></div><div class="tv-frog" id="frogCharacter" aria-label="Kurbağa rakip"></div><div class="audience" id="audience"></div><div class="crowd-message" id="crowdMessage" aria-live="polite"></div><div class="tv-speech" id="frogSpeech" aria-live="polite">Hazır mısın rakip?</div><div class="tv-question"><div class="tv-meta"><span id="quizProgress">Soru 1/12</span><span class="quiz-timer" id="quizTimer">02:00</span></div><h2 id="quizQuestion"></h2><div class="quiz-choices" id="quizChoices"></div><p class="quiz-feedback" id="quizFeedback" aria-live="polite"></p><button class="quiz-next" id="quizNext" type="button" hidden>Sonraki soru →</button><span id="duelScore" class="tv-duel">Sen 0 — 0 Kurbağa</span><span id="frogLabel" hidden></span></div></div></div><footer>ATOM LAB 3D • Eğitim amaçlı interaktif bilim atlası</footer><script>
function showLab(focusElements=false){document.body.classList.remove('home-mode');resize();requestAnimationFrame(resize);window.scrollTo(0,0);if(focusElements){setTimeout(()=>document.getElementById('element').focus(),60)}}
document.getElementById('startLab').addEventListener('click',()=>showLab());
document.getElementById('startElements').addEventListener('click',()=>showLab(true));
document.getElementById('goHome').addEventListener('click',()=>{document.body.classList.add('home-mode');window.scrollTo(0,0)});

const models=[
{id:'dem',name:'Demokritos ve Leukippos',date:'MÖ 5. yüzyıl',kind:'solid',scientist:'Demokritos (yaklaşık MÖ 460–370) ve hocası olduğu düşünülen Leukippos',bio:'Antik Yunan düşünürleri, maddenin kesintisiz değil çok küçük parçacıklardan ve boşluktan oluştuğunu savundular. Demokritos Abdera ile ilişkilendirilir. Atom görüşü deneysel bir fizik kuramından çok felsefi bir açıklamaydı.',work:'Atomos (bölünemez) düşüncesi; boşluk, hareket ve parçacıkların farklı şekilleri üzerine görüşler.',experiment:'Kontrollü laboratuvar deneyi yoktu; akıl yürütmeye dayanıyordu.',limit:'Atomların bölünebildiği ve atom altı parçacıklar içerdiği bugün bilinmektedir.'},
{id:'arist',name:'Aristoteles’in süreklilik görüşü',date:'MÖ 4. yüzyıl',kind:'solid',scientist:'Aristoteles (MÖ 384–322)',bio:'Stagira doğumlu Yunan filozof, Platon’un öğrencisi ve Lykeion okulunun kurucusuydu. Fizik, mantık, biyoloji ve doğa felsefesi üzerine geniş eserler yazdı.',work:'Maddeyi dört unsur ve niteliklerle açıklayan, atomcu görüşe rakip süreklilik anlayışını savundu.',experiment:'Bu yaklaşım modern anlamda bir atom modeli veya deneysel atom kuramı değildi.',limit:'Modern kimyanın atom, element ve parçacık kanıtlarıyla uyuşmaz.'},
{id:'dalton',name:'Dalton katı küre modeli',date:'1803–1808',kind:'solid',scientist:'John Dalton (1766–1844)',bio:'İngiliz kimyacı, fizikçi ve öğretmen. Manchester’da çalıştı. Gazlar, meteoroloji ve renk görme farklılıkları üzerinde araştırmalar yürüttü.',work:'Modern atom kuramını geliştirdi; elementlerin atomlardan oluştuğunu ve bileşiklerin basit tam sayı oranlarında birleştiğini açıkladı. Katlı oranlar yasasıyla ilişkilidir.',experiment:'Gazların davranışlarını ve bileşiklerdeki kütle oranlarını inceledi.',limit:'Atomu bölünemez sandı; izotopları ve atom altı parçacıkları açıklayamadı.'},
{id:'thomson',name:'Thomson üzümlü kek modeli',date:'1904',kind:'plum',scientist:'Joseph John Thomson (1856–1940)',bio:'İngiliz fizikçi, Cambridge Cavendish Laboratuvarı yöneticisi. 1906 Nobel Fizik Ödülü’nü aldı; elektron üzerine araştırmaları atom anlayışını değiştirdi.',work:'1897’de katot ışınlarıyla elektronun varlığını ortaya koydu ve yük/kütle oranını belirledi. 1904’te pozitif yükün yayıldığı bir kürede elektronları düşündü.',experiment:'Katot ışınlarının elektrik ve manyetik alanlarda sapmasını ölçtü.',limit:'Pozitif yükün küçük bir çekirdekte toplandığını açıklayamadı.'},
{id:'ruth',name:'Rutherford çekirdek modeli',date:'1911',kind:'planet',scientist:'Ernest Rutherford (1871–1937)',bio:'Yeni Zelanda doğumlu fizikçi. Kanada ve Birleşik Krallık’ta çalıştı. Radyoaktivite araştırmalarıyla 1908 Nobel Kimya Ödülü’nü aldı.',work:'Atomun büyük ölçüde boşluk olduğunu ve pozitif yük ile kütlenin küçük çekirdekte toplandığını gösteren modeli geliştirdi.',experiment:'Geiger ve Marsden’in yürüttüğü altın levha alfa saçılması deneyinin sonuçlarını yorumladı.',limit:'Klasik fizik altında elektronların neden çekirdeğe düşmediğini ve çizgi spektrumlarını açıklayamadı.'},
{id:'bohr',name:'Bohr enerji düzeyleri modeli',date:'1913',kind:'bohr',scientist:'Niels Bohr (1885–1962)',bio:'Danimarkalı fizikçi. Kopenhag’da kuantum fiziği çalışmalarına öncülük etti; 1922 Nobel Fizik Ödülü’nü kazandı.',work:'Elektronların belirli izinli enerji düzeylerinde bulunduğunu ve düzey geçişlerinde ışık alıp verdiğini önerdi.',experiment:'Özellikle hidrojenin çizgi spektrumunu kuramsal olarak açıkladı.',limit:'Çok elektronlu atomların ayrıntılı spektrumunu tam açıklayamadı; kesin yörünge varsayımı modern kuramda geçerli değildir.'},
{id:'som',name:'Sommerfeld genişletilmiş Bohr modeli',date:'1916',kind:'ellipse',scientist:'Arnold Sommerfeld (1868–1951)',bio:'Alman kuramsal fizikçi. Münih’te önemli bir fizik okulu kurdu; çok sayıda genç bilim insanı yetiştirdi.',work:'Bohr modeline eliptik yörüngeler ve ek kuantum sayıları ekleyerek ince yapı sorunlarına yaklaşmaya çalıştı.',experiment:'Atom spektrumlarının ince ayrıntılarını matematiksel olarak inceledi.',limit:'Eski kuantum teorisinin belirli yörüngeleri, kuantum mekaniğiyle yer değiştirdi.'},
{id:'debroglie',name:'de Broglie madde dalgaları',date:'1924',kind:'wave',scientist:'Louis de Broglie (1892–1987)',bio:'Fransız fizikçi. Madde dalgaları fikriyle 1929 Nobel Fizik Ödülü’nü aldı.',work:'Elektron gibi parçacıkların dalga özellikleri de taşıyabileceğini ileri sürdü; dalga boyunu momentumla ilişkilendirdi.',experiment:'Elektron kırınımı deneyleri, önerdiği dalga davranışını daha sonra destekledi.',limit:'Tek başına atomun tüm kuantum durumlarını açıklayan eksiksiz bir model değildi.'},
{id:'sch',name:'Schrödinger dalga mekaniği',date:'1926',kind:'cloud',scientist:'Erwin Schrödinger (1887–1961)',bio:'Avusturyalı kuramsal fizikçi. Dalga mekaniğini geliştirdi; 1933 Nobel Fizik Ödülü’nü Paul Dirac ile paylaştı.',work:'Schrödinger denklemi, elektronun atom içindeki izinli kuantum durumlarını matematiksel olarak açıklar.',experiment:'Hidrojen atomunun enerji düzeylerini dalga denklemiyle elde etti.',limit:'Çizilen elektron bulutu, elektronun gerçek zamanlı izlediği bir yol değildir.'},
{id:'heis',name:'Heisenberg kuantum yaklaşımı',date:'1925–1927',kind:'cloud',scientist:'Werner Heisenberg (1901–1976)',bio:'Alman kuramsal fizikçi. Matris mekaniğinin kurucularındandır; 1932 Nobel Fizik Ödülü’nü aldı.',work:'1925’te matris mekaniğini geliştirdi; 1927’de belirsizlik ilkesini formüle etti.',experiment:'Atom spektrumlarını ölçülebilir nicelikler üzerinden kuramsal olarak açıklamaya çalıştı.',limit:'Bu yaklaşım bir gezegen yörüngesi modeli değildir; parçacığın konumu ve momentumu aynı anda sınırsız kesinlikle belirlenemez.'},
{id:'born',name:'Born olasılık yorumu',date:'1926',kind:'cloud',scientist:'Max Born (1882–1970)',bio:'Alman-İngiliz fizikçi ve matematikçi. Kuantum mekaniğine katkıları için 1954 Nobel Fizik Ödülü’nü aldı.',work:'Dalga fonksiyonunun mutlak değer karesini olasılık yoğunluğu olarak yorumladı.',experiment:'Kuantum saçılma süreçlerinin matematiksel açıklamaları üzerinde çalıştı.',limit:'Bulut görseli olasılığı temsil eder; elektronun katı, bulanık bir madde olduğunu söylemez.'},
{id:'pauli',name:'Pauli ilkesi ve orbitaller',date:'1925',kind:'orbital',scientist:'Wolfgang Pauli (1900–1958)',bio:'Avusturya doğumlu kuramsal fizikçi. 1945 Nobel Fizik Ödülü’nü aldı.',work:'Pauli dışarlama ilkesi, atomdaki elektronların kuantum durumlarını ve periyodik tablonun düzenini anlamada temel rol oynar.',experiment:'Atom spektrumları ve elektronların kuantum sayıları arasındaki ilişkileri araştırdı.',limit:'Bu bir tek başına atom resmi değil, modern kuantum kuramının temel ilkesidir.'},
{id:'chad',name:'Chadwick nötronlu çekirdek',date:'1932',kind:'bohr',scientist:'James Chadwick (1891–1974)',bio:'İngiliz fizikçi. Rutherford ile çalıştı; nötronun keşfi nedeniyle 1935 Nobel Fizik Ödülü’nü kazandı.',work:'1932’de yüksüz nötronu keşfederek atom çekirdeğinin proton ve nötronlardan oluştuğunun anlaşılmasına katkıda bulundu.',experiment:'Berilyumdan çıkan ışınımın parafinden proton koparmasını inceleyerek nötronu tanımladı.',limit:'Nötronun keşfi, Bohr yörüngelerinin doğru olduğu anlamına gelmez.'},
{id:'modern',name:'Modern kuantum atom modeli',date:'1920’ler–günümüz',kind:'orbital',scientist:'Schrödinger, Heisenberg, Born, Pauli, Dirac ve birçok araştırmacı',bio:'Modern atom teorisi tek bir bilim insanının ürünü değildir. 20. yüzyılda dalga mekaniği, matris mekaniği, spin, olasılık yorumu ve relativistik kuantum kuramı bir araya geldi.',work:'Elektronlar kesin dairesel yörüngeler yerine kuantum durumları ve orbitallerle betimlenir; çekirdek proton ve nötronları içerir.',experiment:'Atom spektrumları, elektron kırınımı, saçılma ve modern spektroskopiyle sınanır.',limit:'Buradaki 3D orbital, gerçek ölçekte veya deneyde doğrudan çekilmiş bir atom fotoğrafı değildir.'}
];
const elements=[["H","Hidrojen",1,0],["He","Helyum",2,2],["Li","Lityum",3,4],["Be","Berilyum",4,5],["B","Bor",5,6],["C","Karbon",6,6],["N","Azot",7,7],["O","Oksijen",8,8],["F","Flor",9,10],["Ne","Neon",10,10],["Na","Sodyum",11,12],["Mg","Magnezyum",12,12],["Al","Alüminyum",13,14],["Si","Silisyum",14,14],["P","Fosfor",15,16],["S","Kükürt",16,16],["Cl","Klor",17,18],["Ar","Argon",18,22],["K","Potasyum",19,20],["Ca","Kalsiyum",20,20],["Sc","Skandiyum",21,24],["Ti","Titanyum",22,26],["V","Vanadyum",23,28],["Cr","Krom",24,28],["Mn","Mangan",25,30],["Fe","Demir",26,30],["Co","Kobalt",27,32],["Ni","Nikel",28,30],["Cu","Bakır",29,34],["Zn","Çinko",30,34],["Ga","Galyum",31,38],["Ge","Germanyum",32,42],["As","Arsenik",33,42],["Se","Selenyum",34,46],["Br","Brom",35,44],["Kr","Kripton",36,48],["Rb","Rubidyum",37,48],["Sr","Stronsiyum",38,50],["Y","İtriyum",39,50],["Zr","Zirkonyum",40,50],["Nb","Niyobyum",41,52],["Mo","Molibden",42,56],["Tc","Teknesyum",43,54],["Ru","Rutenyum",44,58],["Rh","Rodyum",45,58],["Pd","Paladyum",46,60],["Ag","Gümüş",47,60],["Cd","Kadmiyum",48,66],["In","İndiyum",49,66],["Sn","Kalay",50,70],["Sb","Antimon",51,70],["Te","Tellür",52,78],["I","İyot",53,74],["Xe","Ksenon",54,78],["Cs","Sezyum",55,78],["Ba","Baryum",56,82],["La","Lantan",57,82],["Ce","Seryum",58,82],["Pr","Praseodim",59,82],["Nd","Neodim",60,82],["Pm","Prometyum",61,84],["Sm","Samaryum",62,90],["Eu","Evropiyum",63,90],["Gd","Gadolinyum",64,94],["Tb","Terbiyum",65,94],["Dy","Disprozyum",66,98],["Ho","Holmiyum",67,98],["Er","Erbiyum",68,98],["Tm","Tulyum",69,100],["Yb","İterbiyum",70,104],["Lu","Lutesyum",71,104],["Hf","Hafniyum",72,108],["Ta","Tantal",73,108],["W","Tungsten",74,110],["Re","Reniyum",75,112],["Os","Osmiyum",76,116],["Ir","İridyum",77,116],["Pt","Platin",78,117],["Au","Altın",79,118],["Hg","Cıva",80,122],["Tl","Talyum",81,124],["Pb","Kurşun",82,126],["Bi","Bizmut",83,126],["Po","Polonyum",84,125],["At","Astatin",85,125],["Rn","Radon",86,136],["Fr","Fransiyum",87,136],["Ra","Radyum",88,138],["Ac","Aktinyum",89,138],["Th","Toryum",90,142],["Pa","Protaktinyum",91,140],["U","Uranyum",92,146],["Np","Neptünyum",93,143],["Pu","Plütonyum",94,144],["Am","Amerikyum",95,146],["Cm","Küriyum",96,147],["Bk","Berkelyum",97,150],["Cf","Kaliforniyum",98,151],["Es","Aynştaynyum",99,153],["Fm","Fermiyum",100,157],["Md","Mendelevyum",101,157],["No","Nobelyum",102,157],["Lr","Lavrenciyum",103,159],["Rf","Rutherfordiyum",104,163],["Db","Dubniyum",105,163],["Sg","Siborgiyum",106,165],["Bh","Bohriyum",107,163],["Hs","Hassiyum",108,161],["Mt","Meitneriyum",109,169],["Ds","Darmstadtiyum",110,171],["Rg","Röntgenyum",111,170],["Cn","Kopernikyum",112,173],["Nh","Nihonyum",113,171],["Fl","Flerovyum",114,175],["Mc","Moskovyum",115,173],["Lv","Livermoryum",116,177],["Ts","Tennessin",117,175],["Og","Oganesson",118,176]];
const menu=document.getElementById('menu'),facts=document.getElementById('facts'),select=document.getElementById('element');models.forEach((m,i)=>{let b=document.createElement('button');b.className='model';b.innerHTML=`<b>${m.name}</b><small>${m.date}</small>`;b.onclick=()=>choose(i);menu.append(b)});elements.forEach((e,i)=>{let o=document.createElement('option');o.value=i;o.textContent=`${e[0]} — ${e[1]}`;select.append(o)});select.value=5;
let chosen=5,angleX=-.28,angleY=.35,zoom=1,run=true,showLabels=false,phase=0;const cv=document.getElementById('canvas'),ctx=cv.getContext('2d');let W=600,H=500;function resize(){let r=cv.getBoundingClientRect(),d=Math.min(devicePixelRatio||1,2);W=r.width;H=r.height;cv.width=Math.round(W*d);cv.height=Math.round(H*d);ctx.setTransform(d,0,0,d,0,0)}window.addEventListener('resize',resize);new ResizeObserver(()=>{if(cv.getBoundingClientRect().width>0)resize()}).observe(document.getElementById('stage'));resize();
function choose(i){chosen=i;[...menu.children].forEach((b,j)=>b.classList.toggle('active',i===j));let m=models[i];document.getElementById('modelName').textContent=m.name;document.getElementById('stageLabel').textContent=m.date;facts.innerHTML=`<h2>${m.name}</h2><span class="pill">${m.date}</span><h3>Bilim insanı ve yaşamı</h3><p class="bodytext"><b>${m.scientist}</b><br>${m.bio}</p><h3>Teori ve bilimsel çalışmaları</h3><p class="bodytext">${m.work}</p><h3>Araştırmaları ve deneyleri</h3><p class="bodytext">${m.experiment}</p><h3>Modelin sınırlamaları</h3><p class="bodytext">${m.limit}</p><h3>Seçilen element</h3><div id="atomdata"></div>`;updateAtom()};function updateAtom(){let e=elements[+select.value],t=document.getElementById('atomdata');if(t)t.innerHTML=`<span class="pill">${e[1]} (${e[0]})</span><span class="pill">${e[2]} proton</span><span class="pill">${e[3]} nötron</span><span class="pill">${e[2]} elektron</span><p class="mini">Nötron sayısı yaygın veya referans izotopa göredir; radyoaktif elementlerde izotop seçimi değişebilir. Tarihsel modellerde gösterim şematiktir.</p>`}select.onchange=updateAtom;
function rot(x,y,z){let cy=Math.cos(angleY),sy=Math.sin(angleY),cx=Math.cos(angleX),sx=Math.sin(angleX);let xx=x*cy+z*sy,zz=-x*sy+z*cy;return [xx, y*cx-zz*sx,y*sx+zz*cx]}function proj(x,y,z){let p=rot(x,y,z),scale=Math.min(W,H)*.31*zoom,depth=4.8/(4.8+p[2]*.25);return [W/2+p[0]*scale*depth,H/2+p[1]*scale*depth,depth,p[2]]}function dot(x,y,z,r,color,label){let p=proj(x,y,z);ctx.beginPath();ctx.arc(p[0],p[1],Math.max(1,r*Math.min(W,H)*.3*zoom*p[2]),0,7);ctx.fillStyle=color;ctx.shadowColor=color;ctx.shadowBlur=11;ctx.fill();ctx.shadowBlur=0;if(showLabels&&label){ctx.font='11px Segoe UI';ctx.fillStyle='#e7f6ff';ctx.fillText(label,p[0]+9,p[1]-8)}}function path(points,color,width=1.4){ctx.beginPath();points.forEach((v,i)=>{let p=proj(...v);i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1])});ctx.strokeStyle=color;ctx.lineWidth=width;ctx.stroke()}
function sphere(r,col){for(let j=0;j<20;j++){let y=-r+2*r*j/19,rr=Math.sqrt(Math.max(0,r*r-y*y));let pts=[];for(let k=0;k<=90;k++){let a=k*Math.PI*2/90;pts.push([rr*Math.cos(a),y,rr*Math.sin(a)])}path(pts,col,1.1)}for(let j=0;j<16;j++){let a=j*Math.PI/16,pts=[];for(let k=0;k<=90;k++){let t=k*Math.PI*2/90;pts.push([r*Math.sin(t)*Math.cos(a),r*Math.cos(t),r*Math.sin(t)*Math.sin(a)])}path(pts,col,.7)}}
function nucleus(){let e=elements[+select.value],count=Math.min(e[2]+e[3],42);for(let i=0;i<count;i++){let a=i*2.39996,rr=.24*Math.cbrt((i+.5)/count),z=1-2*(i+.5)/count,xy=Math.sqrt(1-z*z);dot(rr*xy*Math.cos(a),rr*xy*Math.sin(a),rr*z,.044,i<e[2]?'#ff866f':'#a4c9ef',i<e[2]?'proton':'nötron')}}
function orbit(rx,ry,tilt,n,elliptic=false,wave=false){let pts=[];for(let j=0;j<=180;j++){let a=j*2*Math.PI/180,r=wave?1+.055*Math.sin(a*12):1;pts.push([rx*Math.cos(a)*r,ry*Math.sin(a)*Math.cos(tilt)*r,ry*Math.sin(a)*Math.sin(tilt)*r])}path(pts,wave?'#d39dff8f':'#5ecce96b',1.6);for(let k=0;k<n;k++){let a=phase*(.55+1/rx)+k*2*Math.PI/n;dot(rx*Math.cos(a),ry*Math.sin(a)*Math.cos(tilt),ry*Math.sin(a)*Math.sin(tilt),.041,'#6df2ff','elektron')}}
function cloud(orbital=false){let n=orbital?1700:1450;for(let i=0;i<n;i++){let u=((i*.61803398875)%1),v=((i*.754877666)%1),w=((i*.569840291)%1),a=2*Math.PI*u,z=2*v-1,s=Math.sqrt(1-z*z);let r=orbital?(.24+1.28*Math.pow(w,.6)):(.13+1.43*Math.pow(w,.48));let x=r*s*Math.cos(a),y=r*s*Math.sin(a),zz=r*z;if(orbital){let lobe=Math.abs(z)>0.34; if(!lobe)continue;x*=.62;y*=.62;zz*=1.25}let p=proj(x,y,zz);ctx.fillStyle=orbital?'rgba(185,127,255,.23)':'rgba(90,208,255,.19)';ctx.fillRect(p[0],p[1],1.9,1.9)}}
function draw(){if(W<10||H<10){requestAnimationFrame(draw);return;}ctx.clearRect(0,0,W,H);let g=ctx.createRadialGradient(W/2,H/2,15,W/2,H/2,Math.max(W,H)*.58);g.addColorStop(0,'#1a3758');g.addColorStop(1,'#071020');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);let kind=models[chosen].kind,e=elements[+select.value],count=Math.min(e[2],40);if(kind==='solid'){sphere(1.12,'#65b8e89a');for(let i=0;i<140;i++){let a=i*2.399,z=1-2*(i+.5)/140,r=Math.sqrt(1-z*z);dot(1.10*r*Math.cos(a),1.10*r*Math.sin(a),1.10*z,.011,'#60c9ef')} }else if(kind==='plum'){sphere(1.17,'#ff8eae78');for(let i=0;i<Math.min(18,count+3);i++){let a=i*2.4,z=1-2*(i+.5)/Math.min(18,count+3),r=.9*Math.sqrt(1-z*z);dot(r*Math.cos(a),r*Math.sin(a),.9*z,.045,'#67edff','elektron')}}else if(kind==='cloud'||kind==='orbital'){cloud(kind==='orbital');nucleus()}else{nucleus();if(kind==='planet'){orbit(1.15,1.15,.4,Math.min(count,5));orbit(1.45,1.45,1.7,Math.min(count,5))}else if(kind==='ellipse'){orbit(1.25,.62,.7,Math.min(count,4));orbit(.85,1.43,1.7,Math.min(count,4));orbit(1.4,1.4,.1,Math.min(count,3))}else if(kind==='wave'){orbit(1.1,1.1,.5,Math.min(count,3),false,true);orbit(1.43,1.43,1.6,Math.min(count,4),false,true)}else{let shells=[2,8,18,32,32,18,8],left=count;for(let i=0;i<shells.length&&left>0;i++){let n=Math.min(left,shells[i]);orbit(.65+i*.31,.65+i*.31,[.5,1.7,.1,2.2,.9,1.3,2.5][i],n);left-=n}}}if(run)phase+=.012*(+document.getElementById('speed').value/65);requestAnimationFrame(draw)}
let down=false,lx=0,ly=0;cv.addEventListener('pointerdown',e=>{down=true;lx=e.clientX;ly=e.clientY;cv.setPointerCapture(e.pointerId)});cv.addEventListener('pointerup',()=>down=false);cv.addEventListener('pointermove',e=>{if(!down)return;angleY+=(e.clientX-lx)*.008;angleX+=(e.clientY-ly)*.008;lx=e.clientX;ly=e.clientY});cv.addEventListener('wheel',e=>{e.preventDefault();zoom=Math.max(.45,Math.min(2.6,zoom*(e.deltaY>0?.9:1.1)))},{passive:false});document.getElementById('play').onclick=()=>{run=!run;document.getElementById('play').textContent=run?'⏸ Animasyonu durdur':'▶ Animasyonu başlat'};document.getElementById('reset').onclick=()=>{angleX=-.28;angleY=.35;zoom=1};document.getElementById('labels').onclick=()=>showLabels=!showLabels;choose(5);requestAnimationFrame(draw);
</script>
<script>
const I18N={"en": ["Created by Muhammed Mustafa Seyhan", "Atomic models • Scientists • Experiments • Interactive science atlas", "Home", "Offline 3D engine · No external libraries", "INTERACTIVE SCIENCE ATLAS", "Explore the invisible world of atoms.", "Journey from ancient atomic ideas to quantum theory. Rotate 3D models, explore 118 elements, and learn about scientists and experiments.", "Enter the 3D laboratory →", "Explore 118 elements", "elements", "historical approaches", "interactive experience", "Atomic models", "3D Atom", "Drag: rotate · Wheel: zoom", "Pause animation", "Reset view", "Particle labels", "Speed", "Element (118)", "Drawing engine ready. Models are rendered in this file.", "Models are educational representations, not to-scale photographs of atoms.", "Development of atomic theory", "Atomic theory evolved from ancient philosophy through Dalton, Thomson, Rutherford, Bohr and quantum mechanics. Each model addressed evidence the previous one could not explain.", "Sources", "Educational interactive science atlas", "Scientist and biography", "Theory and scientific work", "Research and experiments", "Limitations", "Selected element", "protons", "neutrons", "electrons", "Neutron count depends on isotope; historical models are schematic.", "Start animation"], "de": ["Erstellt von Muhammed Mustafa Seyhan", "Atommodelle • Wissenschaftler • Experimente • Interaktiver Wissenschaftsatlas", "Startseite", "Offline-3D-Engine · Keine externen Bibliotheken", "INTERAKTIVER WISSENSCHAFTSATLAS", "Entdecke die unsichtbare Welt der Atome.", "Von antiken Atomvorstellungen bis zur Quantentheorie. Drehe 3D-Modelle, erkunde 118 Elemente und entdecke Wissenschaftler und Experimente.", "Zum 3D-Labor →", "118 Elemente entdecken", "Elemente", "historische Ansätze", "interaktives Erlebnis", "Atommodelle", "3D-Atom", "Ziehen: drehen · Mausrad: zoomen", "Animation pausieren", "Ansicht zurücksetzen", "Teilchenbezeichnungen", "Tempo", "Element (118)", "Zeichenengine bereit. Modelle werden lokal dargestellt.", "Modelle sind didaktische Darstellungen, keine maßstabsgetreuen Atomfotos.", "Entwicklung der Atomtheorie", "Von der antiken Philosophie über Dalton, Thomson, Rutherford und Bohr bis zur Quantenmechanik: Jedes Modell erklärte neue Beobachtungen.", "Quellen", "Interaktiver Wissenschaftsatlas", "Wissenschaftler und Biografie", "Theorie und wissenschaftliche Arbeit", "Forschung und Experimente", "Grenzen des Modells", "Ausgewähltes Element", "Protonen", "Neutronen", "Elektronen", "Neutronenzahl hängt vom Isotop ab; historische Modelle sind schematisch.", "Animation starten"], "fr": ["Créé par Muhammed Mustafa Seyhan", "Modèles atomiques • Scientifiques • Expériences • Atlas interactif", "Accueil", "Moteur 3D hors ligne · Sans bibliothèque externe", "ATLAS SCIENTIFIQUE INTERACTIF", "Explore le monde invisible des atomes.", "Des idées antiques à la théorie quantique : fais tourner les modèles 3D, explore 118 éléments et découvre les scientifiques.", "Entrer dans le laboratoire 3D →", "Explorer les 118 éléments", "éléments", "approches historiques", "expérience interactive", "Modèles atomiques", "Atome 3D", "Glisser : tourner · Molette : zoom", "Mettre en pause", "Réinitialiser la vue", "Noms des particules", "Vitesse", "Élément (118)", "Moteur graphique prêt. Modèles dessinés localement.", "Les modèles sont pédagogiques et ne représentent pas les atomes à l’échelle.", "Évolution de la théorie atomique", "Des philosophes antiques à Dalton, Thomson, Rutherford, Bohr et à la mécanique quantique, chaque modèle a répondu à de nouvelles observations.", "Sources", "Atlas scientifique interactif", "Scientifique et biographie", "Théorie et travaux", "Recherches et expériences", "Limites du modèle", "Élément sélectionné", "protons", "neutrons", "électrons", "Le nombre de neutrons dépend de l’isotope ; les modèles historiques sont schématiques.", "Reprendre l’animation"], "ru": ["Создано Мухаммедом Мустафой Сейханом", "Модели атома • Учёные • Эксперименты • Интерактивный атлас", "Главная", "Автономный 3D-движок · Без внешних библиотек", "ИНТЕРАКТИВНЫЙ АТЛАС НАУКИ", "Исследуй невидимый мир атомов.", "От древних представлений до квантовой теории. Вращай 3D-модели, изучай 118 элементов, учёных и эксперименты.", "Войти в 3D-лабораторию →", "Изучить 118 элементов", "элементов", "исторических подходов", "интерактивный опыт", "Модели атома", "3D-атом", "Перетаскивание: вращать · Колесо: масштаб", "Остановить анимацию", "Сбросить вид", "Названия частиц", "Скорость", "Элемент (118)", "Движок готов. Модели создаются локально.", "Модели учебные и не показывают атомы в реальном масштабе.", "История атомной теории", "От античной философии до Дальтона, Томсона, Резерфорда, Бора и квантовой механики: каждая модель объясняла новые данные.", "Источники", "Интерактивный атлас науки", "Учёный и биография", "Теория и научная работа", "Исследования и эксперименты", "Ограничения модели", "Выбранный элемент", "протонов", "нейтронов", "электронов", "Число нейтронов зависит от изотопа; исторические модели схематичны.", "Запустить анимацию"], "zh": ["穆罕默德·穆斯塔法·塞伊汉 制作", "原子模型 • 科学家 • 实验 • 互动科学图鉴", "首页", "离线3D引擎 · 无外部依赖", "互动科学图鉴", "探索原子的隐形世界。", "从古代原子思想到量子理论。旋转3D模型，探索118种元素，了解科学家与实验。", "进入3D实验室 →", "探索118种元素", "种元素", "种历史理论", "互动体验", "原子模型", "3D原子", "拖动旋转 · 滚轮缩放", "暂停动画", "重置视角", "粒子名称", "速度", "元素 (118)", "绘图引擎已就绪。模型在本地绘制。", "模型仅用于教学，并非原子的真实比例照片。", "原子理论的发展", "从古代哲学到道尔顿、汤姆孙、卢瑟福、玻尔和量子力学，每个模型都解释了新的实验证据。", "资料来源", "互动科学图鉴", "科学家与生平", "理论与科研成果", "研究与实验", "模型的局限", "所选元素", "质子", "中子", "电子", "中子数量因同位素而异；历史模型为示意图。", "继续动画"]};
const TR=['MUHAMMED MUSTAFA SEYHAN YAPMIŞTIR','Atom modelleri • Bilim insanları • Deneyler • Etkileşimli bilim atlası','Ana sayfa','Çevrimdışı 3D motor · Harici kütüphane yok','İNTERAKTİF BİLİM ATLASI','Atomun görünmeyen dünyasını keşfet.','Antik atom düşüncesinden modern kuantum kuramına uzanan bilim yolculuğuna katıl. Modelleri 3D döndür, 118 elementi incele, bilim insanlarının hayatlarını ve deneylerini öğren.','3D laboratuvara gir →','118 elementi keşfet','element','tarihsel yaklaşım','etkileşimli deneyim','Atom modelleri','3D Atom','Sürükle: döndür · Tekerlek: yakınlaş','Animasyonu durdur','Görünümü sıfırla','Parçacık isimleri','Hız','Element (118)','Çizim motoru hazır. 3D modeller doğrudan bu dosyada çiziliyor.','Modeller ölçekli atom fotoğrafları değildir. Eski modeller tarihsel düşünceleri; modern orbital görünümü olasılık yoğunluğunu temsil eder.','Atom teorisinin gelişimi','Atom fikri antik felsefeden doğdu. Dalton deneysel kimyaya dayalı atom kuramını kurdu. Thomson elektronun varlığını gösterdi. Rutherford atom çekirdeğini ortaya koydu. Bohr belirli enerji düzeylerini kullandı. Sommerfeld modeli genişletti; de Broglie, Heisenberg, Schrödinger, Born ve Pauli kuantum yaklaşımını geliştirdi. Chadwick nötronu keşfetti. Her yeni açıklama, önceki modelin açıklayamadığı deneysel bulgulara yanıt verdi.','Kaynaklar','Eğitim amaçlı interaktif bilim atlası','Bilim insanı ve yaşamı','Teori ve bilimsel çalışmaları','Araştırmaları ve deneyleri','Modelin sınırlamaları','Seçilen element','proton','nötron','elektron','Nötron sayısı yaygın veya referans izotopa göredir; radyoaktif elementlerde izotop seçimi değişebilir. Tarihsel modellerde gösterim şematiktir.','Animasyonu başlat'];
const originals=models.map(m=>({...m}));
const scientists=['Democritus and Leucippus','Aristotle','John Dalton','J. J. Thomson','Ernest Rutherford','Niels Bohr','Arnold Sommerfeld','Louis de Broglie','Erwin Schrödinger','Werner Heisenberg','Max Born','Wolfgang Pauli','James Chadwick','Modern quantum model'];
const overview={
en:['Ancient atomism proposed indivisible particles and empty space.','Aristotle described matter using continuous substances and four elements.','Dalton formulated atomic theory using chemical combination laws.','Thomson discovered the electron and proposed the plum-pudding model.','Rutherford inferred a small dense nucleus from alpha-particle scattering.','Bohr introduced quantized energy levels to explain hydrogen spectra.','Sommerfeld extended Bohr’s model with elliptical orbits.','De Broglie proposed wave-like behavior of matter.','Schrödinger developed wave mechanics and the wave equation.','Heisenberg formulated matrix mechanics and the uncertainty principle.','Born interpreted the wave function probabilistically.','Pauli formulated the exclusion principle.','Chadwick discovered the neutron in 1932.','Quantum mechanics describes electrons using orbitals and probabilities.'],
de:['Die antike Atomlehre nahm kleinste Teilchen und leeren Raum an.','Aristoteles erklärte Materie mit vier Elementen und kontinuierlicher Substanz.','Dalton entwickelte die Atomtheorie aus chemischen Gesetzen.','Thomson entdeckte das Elektron und entwickelte das Rosinenkuchenmodell.','Rutherford erschloss aus Streuexperimenten einen kleinen Atomkern.','Bohr erklärte das Wasserstoffspektrum durch quantisierte Energieniveaus.','Sommerfeld erweiterte Bohrs Modell um elliptische Bahnen.','De Broglie schlug Materiewellen vor.','Schrödinger entwickelte die Wellenmechanik.','Heisenberg entwickelte die Matrizenmechanik und Unschärferelation.','Born deutete die Wellenfunktion als Wahrscheinlichkeit.','Pauli formulierte das Ausschließungsprinzip.','Chadwick entdeckte 1932 das Neutron.','Quantenmechanik beschreibt Elektronen durch Orbitale und Wahrscheinlichkeiten.'],
fr:['L’atomisme antique proposait des particules indivisibles et le vide.','Aristote décrivait la matière par quatre éléments continus.','Dalton développa sa théorie atomique à partir des lois chimiques.','Thomson découvrit l’électron et proposa le modèle du pudding.','Rutherford déduisit l’existence du noyau grâce à la diffusion des particules alpha.','Bohr expliqua le spectre de l’hydrogène par des niveaux d’énergie quantifiés.','Sommerfeld ajouta des orbites elliptiques au modèle de Bohr.','De Broglie proposa les ondes de matière.','Schrödinger développa la mécanique ondulatoire.','Heisenberg développa la mécanique matricielle et le principe d’incertitude.','Born donna une interprétation probabiliste de la fonction d’onde.','Pauli formula le principe d’exclusion.','Chadwick découvrit le neutron en 1932.','La mécanique quantique décrit les électrons par des orbitales et probabilités.'],
ru:['Античный атомизм предполагал неделимые частицы и пустоту.','Аристотель объяснял материю четырьмя непрерывными стихиями.','Дальтон сформулировал атомную теорию на основе химических законов.','Томсон открыл электрон и предложил модель «пудинга».','Резерфорд обнаружил компактное ядро по рассеянию альфа-частиц.','Бор объяснил спектр водорода квантованными уровнями энергии.','Зоммерфельд расширил модель Бора эллиптическими орбитами.','Де Бройль предложил волновую природу материи.','Шрёдингер создал волновую механику.','Гейзенберг разработал матричную механику и принцип неопределённости.','Борн дал вероятностную интерпретацию волновой функции.','Паули сформулировал принцип запрета.','Чедвик открыл нейтрон в 1932 году.','Квантовая механика описывает электроны орбиталями и вероятностями.'],
zh:['古代原子论提出不可分粒子与虚空。','亚里士多德认为物质由四元素连续构成。','道尔顿依据化学定律提出原子理论。','汤姆孙发现电子并提出葡萄干布丁模型。','卢瑟福通过α粒子散射推断出微小原子核。','玻尔用量子化能级解释氢原子光谱。','索末菲为玻尔模型加入椭圆轨道。','德布罗意提出物质波假说。','薛定谔建立波动力学。','海森堡提出矩阵力学与不确定性原理。','玻恩提出波函数的概率解释。','泡利提出不相容原理。','查德威克于1932年发现中子。','量子力学用轨道与概率描述电子。']};
const elementNames={en:'Hydrogen Helium Lithium Beryllium Boron Carbon Nitrogen Oxygen Fluorine Neon Sodium Magnesium Aluminium Silicon Phosphorus Sulfur Chlorine Argon Potassium Calcium'.split(' '),de:'Wasserstoff Helium Lithium Beryllium Bor Kohlenstoff Stickstoff Sauerstoff Fluor Neon Natrium Magnesium Aluminium Silicium Phosphor Schwefel Chlor Argon Kalium Calcium'.split(' '),fr:'Hydrogène Hélium Lithium Béryllium Bore Carbone Azote Oxygène Fluor Néon Sodium Magnésium Aluminium Silicium Phosphore Soufre Chlore Argon Potassium Calcium'.split(' '),ru:'Водород Гелий Литий Бериллий Бор Углерод Азот Кислород Фтор Неон Натрий Магний Алюминий Кремний Фосфор Сера Хлор Аргон Калий Кальций'.split(' '),zh:'氢 氦 锂 铍 硼 碳 氮 氧 氟 氖 钠 镁 铝 硅 磷 硫 氯 氩 钾 钙'.split(' ')};
let lang='tr';const t=i=>(I18N[lang]||TR)[i];
function translateSite(){
lang=document.getElementById('languagePicker').value;document.documentElement.lang=lang==='zh'?'zh-CN':lang;localStorage.setItem('atomLabLanguage',lang);
const set=(q,v)=>{let e=document.querySelector(q);if(e)e.textContent=v};
set('.creator-credit',t(0));set('header .sub',t(1));set('#goHome','⌂ '+t(2));set('header .row .sub',t(3));set('.eyebrow',t(4));document.querySelector('.home h2').textContent=t(5);set('.home p',t(6));set('#startLab','⚛ '+t(7));set('#startElements',t(8));let stats=document.querySelectorAll('.home-stats span');stats[0].innerHTML='<strong>118</strong> '+t(9);stats[1].innerHTML='<strong>14</strong> '+t(10);stats[2].innerHTML='<strong>3D</strong> '+t(11);
set('.models h2',t(12));set('.stage-info .mini',t(14));set('#play',(run?'⏸ '+t(15):'▶ '+t(36)));set('#reset','↺ '+t(16));set('#labels','● '+t(17));let labels=document.querySelectorAll('main .row label');labels[0].firstChild.textContent=t(18)+' ';labels[1].firstChild.textContent=t(19)+' ';set('#notice','✓ '+t(20));set('main section.panel > .mini',t(21));set('.timeline h2',t(22));set('.timeline .bodytext',t(23));set('.timeline h3',t(24));set('footer','ATOM LAB 3D • '+t(25));
models.forEach((m,i)=>{Object.assign(m,originals[i]);if(lang!=='tr'){m.name=scientists[i]||m.name;m.bio=overview[lang][i];m.work=overview[lang][i];m.experiment=overview[lang][i];m.limit=t(21);}});
[...menu.children].forEach((b,i)=>b.querySelector('b').textContent=models[i].name);
[...select.options].forEach((o,i)=>{let e=elements[i];o.textContent=e[0]+' — '+(lang==='tr'?e[1]:(elementNames[lang]?.[i]||e[1]));});
const m=models[chosen];set('#modelName',m.name);facts.innerHTML=`<h2>${m.name}</h2><span class="pill">${m.date}</span><h3>${t(26)}</h3><p class="bodytext"><b>${lang==='tr'?m.scientist:scientists[chosen]}</b><br>${m.bio}</p><h3>${t(27)}</h3><p class="bodytext">${m.work}</p><h3>${t(28)}</h3><p class="bodytext">${m.experiment}</p><h3>${t(29)}</h3><p class="bodytext">${m.limit}</p><h3>${t(30)}</h3><div id="atomdata"></div>`;
const e=elements[+select.value],atom=document.getElementById('atomdata');atom.innerHTML=`<span class="pill">${select.options[select.selectedIndex].textContent}</span><span class="pill">${e[2]} ${t(31)}</span><span class="pill">${e[3]} ${t(32)}</span><span class="pill">${e[2]} ${t(33)}</span><p class="mini">${t(34)}</p>`;
}
const oldChoose=choose;choose=function(i){oldChoose(i);translateSite()};
const oldUpdate=updateAtom;updateAtom=function(){oldUpdate();translateSite()};
document.getElementById('languagePicker').addEventListener('change',translateSite);
try{document.getElementById('languagePicker').value=localStorage.getItem('atomLabLanguage')||'tr'}catch(e){}
translateSite();
const originalPlay=document.getElementById('play').onclick;document.getElementById('play').onclick=()=>{originalPlay();translateSite()};
</script>
<script>
(()=>{
const L={tr:['Etkinlik: Bilge Kurbağa ile Atom Yarışması','Kurbağa sana atom modelleri, bilim insanları ve elementler hakkında dört şıklı sorular soracak. Her soruda 2 dakikan var!','Etkinliğe Başla','Bilge Kurbağa','Soru','Puan','Vırak! Doğru cevabı bul!','Sonraki soru','Sonucu Gör','Doğru!','Yanlış!','Süre doldu!','Doğru cevap:','Tebrikler! Yarışma tamamlandı.','Tekrar Oyna','Ana sayfaya dön'],en:['Activity: Atomic Quiz with the Wise Frog','The animated 3D-style frog asks four-option questions about atomic models, scientists and elements. You have 2 minutes per question!','Start Activity','Wise Frog','Question','Score','Ribbit! Find the answer!','Next question','See results','Correct!','Not quite!','Time is up!','Correct answer:','Great work! Quiz completed.','Play Again','Return to site'],de:['Aktivität: Atomquiz mit dem klugen Frosch','Der animierte Frosch stellt Fragen zu Atommodellen, Forschern und Elementen. Du hast 2 Minuten pro Frage!','Quiz starten','Kluger Frosch','Frage','Punkte','Quak! Finde die Antwort!','Nächste Frage','Ergebnis','Richtig!','Leider falsch!','Zeit abgelaufen!','Richtige Antwort:','Quiz abgeschlossen!','Noch einmal','Zurück zur Seite'],fr:['Activité : quiz atomique avec la grenouille','La grenouille animée pose des questions à quatre choix sur les atomes et les scientifiques. Tu as 2 minutes par question !','Commencer','Grenouille savante','Question','Score','Coâ ! Trouve la réponse !','Question suivante','Voir le résultat','Bravo !','Incorrect !','Temps écoulé !','Bonne réponse :','Quiz terminé !','Rejouer','Retour au site'],ru:['Игра: атомная викторина с лягушкой','Анимированная лягушка задаёт вопросы с четырьмя вариантами об атомах и учёных. На каждый вопрос — 2 минуты!','Начать игру','Мудрая лягушка','Вопрос','Очки','Ква! Найди ответ!','Следующий вопрос','Результат','Верно!','Неверно!','Время вышло!','Правильный ответ:','Викторина завершена!','Играть снова','Вернуться на сайт'],zh:['活动：智慧青蛙原子知识问答','动画青蛙会提出有关原子模型、科学家和元素的四选一问题。每题限时2分钟！','开始活动','智慧青蛙','问题','得分','呱！找到正确答案！','下一题','查看成绩','正确！','答错了！','时间到！','正确答案：','答题结束！','再玩一次','返回网站']};
// Each question: translated question, four options, correct index, translated explanation.
const Q=[
[['Atom çekirdeğini hangi bilim insanı ortaya koydu?','Who discovered the atomic nucleus?','Wer entdeckte den Atomkern?','Qui a découvert le noyau atomique ?','Кто открыл атомное ядро?','谁发现了原子核？'],['Dalton','Rutherford','Thomson','Bohr'],1,['Rutherford, altın levha deneyinin sonuçlarından atomun küçük ve yoğun bir çekirdeği olduğunu çıkardı.','Rutherford inferred a tiny, dense nucleus from the gold foil experiment.']],
[['Elektronu kim keşfetti?','Who discovered the electron?','Wer entdeckte das Elektron?','Qui a découvert l’électron ?','Кто открыл электрон?','谁发现了电子？'],['Chadwick','Bohr','J. J. Thomson','Demokritos'],2,['Thomson katot ışınları deneyleriyle elektronu keşfetti.','Thomson discovered the electron using cathode rays.']],
[['Bohr modelinde elektronlar nerede bulunur?','In the Bohr model, where are electrons found?','Wo befinden sich Elektronen im Bohr-Modell?','Où sont les électrons dans le modèle de Bohr ?','Где находятся электроны в модели Бора?','在玻尔模型中电子位于哪里？'],['Belirli enerji düzeylerinde','Çekirdeğin içinde','Protonların içinde','Atom dışında rastgele'],0,['Bohr modelinde elektronlar belirli enerji düzeylerinde bulunur.','Bohr proposed discrete electron energy levels.']],
[['Nötronu kim keşfetti?','Who discovered the neutron?','Wer entdeckte das Neutron?','Qui a découvert le neutron ?','Кто открыл нейтрон?','谁发现了中子？'],['Schrödinger','Chadwick','Dalton','Pauli'],1,['James Chadwick nötronu 1932 yılında keşfetti.','James Chadwick discovered the neutron in 1932.']],
[['Atom numarası neyi gösterir?','What does atomic number indicate?','Was gibt die Ordnungszahl an?','Que représente le numéro atomique ?','Что показывает атомный номер?','原子序数表示什么？'],['Nötron sayısını','Kütleyi','Proton sayısını','Katman sayısını'],2,['Atom numarası, çekirdekteki proton sayısıdır.','Atomic number equals the number of protons.']],
[['Hidrojenin atom numarası kaçtır?','What is the atomic number of hydrogen?','Welche Ordnungszahl hat Wasserstoff?','Quel est le numéro atomique de l’hydrogène ?','Какой атомный номер водорода?','氢的原子序数是多少？'],['1','2','6','8'],0,['Hidrojenin çekirdeğinde bir proton bulunur.','Hydrogen has one proton.']],
[['Modern atom modelinde elektronun yeri nasıl açıklanır?','How is electron position described in the modern atomic model?','Wie beschreibt das moderne Atommodell Elektronen?','Comment décrit-on l’électron dans le modèle moderne ?','Как описывают электрон в современной модели?','现代原子模型如何描述电子的位置？'],['Kesin dairesel yörünge','Olasılık dağılımı','Sabit bir nokta','Çekirdekte hareketsiz'],1,['Orbitaller elektronun bulunma olasılığını ifade eder.','Orbitals describe electron probability distributions.']],
[['Üzümlü kek modelini kim önerdi?','Who proposed the plum pudding model?','Wer schlug das Rosinenkuchenmodell vor?','Qui a proposé le modèle du pudding ?','Кто предложил модель пудинга?','谁提出了葡萄干布丁模型？'],['Thomson','Rutherford','Sommerfeld','Born'],0,['Thomson, elektronu içeren erken bir atom modeli önerdi.','Thomson proposed an early model containing electrons.']],
[['Oksijenin atom numarası kaçtır?','What is the atomic number of oxygen?','Welche Ordnungszahl hat Sauerstoff?','Quel est le numéro atomique de l’oxygène ?','Какой атомный номер кислорода?','氧的原子序数是多少？'],['6','7','8','10'],2,['Oksijen atomunun çekirdeğinde sekiz proton vardır.','Oxygen has eight protons.']],
[['Dalton atomları nasıl tanımladı?','How did Dalton describe atoms?','Wie beschrieb Dalton Atome?','Comment Dalton décrivait-il les atomes ?','Как Дальтон описывал атомы?','道尔顿如何描述原子？'],['Elektron bulutları','İçi dolu küçük küreler','Gezegen sistemleri','Dalga fonksiyonları'],1,['Dalton atomları bölünemez küçük küreler olarak düşündü.','Dalton pictured atoms as small indivisible spheres.']],
[['Madde dalgaları fikrini kim ortaya attı?','Who proposed matter waves?','Wer schlug Materiewellen vor?','Qui a proposé les ondes de matière ?','Кто предложил волны материи?','谁提出了物质波？'],['de Broglie','Aristoteles','Chadwick','Thomson'],0,['Louis de Broglie parçacıkların dalga özelliklerini önerdi.','Louis de Broglie proposed wave properties of matter.']],
[['Periyodik tabloda kaç onaylanmış element vardır?','How many confirmed elements are in the periodic table?','Wie viele bestätigte Elemente gibt es?','Combien d’éléments sont confirmés ?','Сколько подтверждённых элементов известно?','目前已确认多少种元素？'],['92','100','118','120'],2,['Periyodik tabloda 118 onaylanmış element bulunur.','There are 118 confirmed elements.']]
];
const lang=()=>document.getElementById('languagePicker').value in L?document.getElementById('languagePicker').value:'tr',tx=i=>L[lang()][i],li=()=>['tr','en','de','fr','ru','zh'].indexOf(lang());
const $=id=>document.getElementById(id);let current=0,score=0,frogScore=0,remaining=120,interval=null,finished=false,order=[],answered=false;
const taunts={tr:{start:['Hazır mısın? Bu laboratuvarın şampiyonu benim!','İyi düşün rakip, seni geçeceğim!'],right:['Vay canına! Bunu bildin ama daha bitmedi!','Şanslıydın! Sonraki soruda görüşürüz!'],wrong:['Vırak! Bir puan bana!','Hah! Bu soruyu ben kazandım!'],win:['Sadece şansın yaver gitti!','Of, bugün yorgundum; yoksa yenilmiştin!','Bu kez kazandın ama rövanşta görüşürüz!','Şansın bugün senden yana, kabul ediyorum!'],lose:'Vırak vırak! Şampiyon kurbağa!',draw:'Berabere! Bir maç daha?',next:'Yeni soru geliyor! İki dakikan var!'},en:{start:['Ready? I am the champion of this lab!'],right:['Nice one! But I am not done!'],wrong:['Ribbit! Point for me!'],win:'You win! I demand a rematch!',lose:'Ribbit! Frog champion!',draw:'A draw! Again?',next:'Next question! Two minutes!'}};
function phrase(kind){const t=taunts[lang()]||taunts.en;const v=t[kind]||taunts.en[kind];return Array.isArray(v)?v[Math.floor(Math.random()*v.length)]:v;}
function talk(msg){$('frogSpeech').textContent='🐸 '+msg;}
function updateDuel(){$('duelScore').textContent=(lang()==='tr'?'Sen ':'You ')+score+'  ⚔  '+frogScore+' '+(lang()==='tr'?'Kurbağa':'Frog');$('playerPodium').textContent=score;$('frogPodium').textContent=frogScore;}
// Audience audio is generated locally using Web Audio; no files, internet, or frog voice needed.
let crowdAudio=null,crowdSoundOn=true;
function getCrowdAudio(){try{const C=window.AudioContext||window.webkitAudioContext;if(!C)return null;if(!crowdAudio)crowdAudio=new C();if(crowdAudio.state==='suspended')crowdAudio.resume().catch(()=>{});return crowdAudio;}catch(e){return null;}}
function crowdNoise(ctx,at,duration,volume,frequency){const sr=ctx.sampleRate,buffer=ctx.createBuffer(1,Math.ceil(duration*sr),sr),d=buffer.getChannelData(0);let last=0;for(let i=0;i<d.length;i++){last=last*.67+(Math.random()*2-1)*.33;d[i]=last;}const source=ctx.createBufferSource();source.buffer=buffer;const filter=ctx.createBiquadFilter();filter.type='bandpass';filter.frequency.value=frequency;filter.Q.value=.65;const gain=ctx.createGain();gain.gain.setValueAtTime(.0001,at);gain.gain.linearRampToValueAtTime(volume,at+.009);gain.gain.exponentialRampToValueAtTime(.0001,at+duration);source.connect(filter).connect(gain).connect(ctx.destination);source.start(at);source.stop(at+duration+.01);}
function applause(){const ctx=getCrowdAudio();if(!ctx||!crowdSoundOn)return;const now=ctx.currentTime+.03;for(let i=0;i<95;i++){let t=now+Math.random()*2.1;crowdNoise(ctx,t,.035+Math.random()*.065,.055+Math.random()*.10,850+Math.random()*2600);} }
function booing(){const ctx=getCrowdAudio();if(!ctx||!crowdSoundOn)return;const now=ctx.currentTime+.03;for(let j=0;j<9;j++){const at=now+Math.random()*.24,dur=1.15+Math.random()*.65,f0=105+Math.random()*85,gain=ctx.createGain();gain.gain.setValueAtTime(.0001,at);gain.gain.linearRampToValueAtTime(.026,at+.16);gain.gain.setValueAtTime(.026,at+dur-.25);gain.gain.exponentialRampToValueAtTime(.0001,at+dur);gain.connect(ctx.destination);for(let k=1;k<=5;k++){const osc=ctx.createOscillator();osc.type=k===1?'sawtooth':'sine';osc.frequency.setValueAtTime(f0*k,at);osc.frequency.linearRampToValueAtTime(f0*k*.82,at+dur);const formant=ctx.createBiquadFilter();formant.type='bandpass';formant.frequency.value=k<3?460:1050;formant.Q.value=.65;const level=ctx.createGain();level.gain.value=(k===1?.7:.42)/k;osc.connect(formant).connect(level).connect(gain);osc.start(at);osc.stop(at+dur+.02);}}}
const soundToggle=document.getElementById('crowdSoundToggle');soundToggle.addEventListener('click',()=>{crowdSoundOn=!crowdSoundOn;soundToggle.setAttribute('aria-pressed',String(crowdSoundOn));soundToggle.textContent=crowdSoundOn?'🔊 Seyirci sesi: Açık':'🔇 Seyirci sesi: Kapalı';if(crowdSoundOn)getCrowdAudio();});
function resizeFrog(){}
function reaction(kind){const f=$('frogCharacter'),a=$('audience'),m=$('crowdMessage');f.classList.remove('angry','happy');a.classList.remove('cheer','boo');void f.offsetWidth;if(kind==='right'){f.classList.add('angry');a.classList.add('cheer');m.textContent='👏 BRAVO! 👏';applause();}else if(kind==='wrong'){f.classList.add('happy');a.classList.add('boo');m.textContent='👎 YUUUU! 👎';booing();}else{m.textContent='';}}
function labels(){ $('activityTitle').textContent='🐸 '+tx(0);$('activityDesc').textContent=tx(1);$('openQuiz').textContent='🐸 '+tx(2)+' →';$('quizTitle').textContent='🐸 '+tx(3);$('frogLabel').textContent=tx(6);if(!$('quizOverlay').hidden){$('quizProgress').textContent=tx(4)+' '+Math.min(current+1,Q.length)+'/'+Q.length+' · '+tx(5)+': '+score; if(!finished&&!answered)renderQuestion();}}
function shuffle(){order=Array.from({length:Q.length},(_,i)=>i);for(let i=order.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[order[i],order[j]]=[order[j],order[i]];}}
function stop(){if(interval!==null){clearInterval(interval);interval=null;}}
function clock(){let m=Math.floor(remaining/60),s=remaining%60;$('quizTimer').textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');$('quizTimer').classList.toggle('urgent',remaining<=20);}
function startTimer(){stop();remaining=120;clock();interval=setInterval(()=>{if($('quizOverlay').hidden){stop();return;}remaining--;clock();if(remaining<=0)answer(-1);},1000);}
function renderQuestion(){const q=Q[order[current]];$('quizQuestion').textContent=q[0][li()];$('quizProgress').textContent=tx(4)+' '+(current+1)+'/'+Q.length+' · '+tx(5)+': '+score;$('quizChoices').replaceChildren();q[1].forEach((v,i)=>{const b=document.createElement('button');b.className='quiz-choice';b.type='button';b.textContent=String.fromCharCode(65+i)+') '+v;b.disabled=answered;b.onclick=()=>answer(i);$('quizChoices').appendChild(b);});$('quizFeedback').textContent='';$('quizNext').hidden=true;}
function answer(i){if(answered||finished)return;answered=true;stop();let q=Q[order[current]],correct=i===q[2];if(correct)score++;else frogScore++;updateDuel();reaction(correct?"right":"wrong");talk(phrase(correct?"right":"wrong"));[...$('quizChoices').children].forEach((b,j)=>{b.disabled=true;if(j===q[2])b.classList.add('correct');else if(j===i)b.classList.add('wrong');});$('quizFeedback').textContent=(i<0?tx(11):correct?tx(9):tx(10))+' '+tx(12)+' '+q[1][q[2]]+'. '+(lang()==='tr'?q[3][0]:q[3][1]);$('quizProgress').textContent=tx(4)+' '+(current+1)+'/'+Q.length+' · '+tx(5)+': '+score;$('quizNext').hidden=false;$('quizNext').textContent=current===Q.length-1?tx(8)+' →':tx(7)+' →';}
function next(){if(current===Q.length-1){finished=true;stop();$('quizQuestion').textContent=tx(13);talk(phrase(score>frogScore?'win':score<frogScore?'lose':'draw'));$('quizChoices').replaceChildren();$('quizFeedback').textContent=tx(5)+': '+score+' / '+Q.length;$('quizTimer').textContent='✓';$('quizNext').textContent=tx(14)+' ↻';$('quizNext').hidden=false;$('quizNext').onclick=start;return;}current++;answered=false;renderQuestion();startTimer();talk(phrase("next"));}
function start(){getCrowdAudio();reaction("reset");shuffle();current=0;score=0;frogScore=0;updateDuel();answered=false;finished=false;$('quizNext').onclick=next;$('quizOverlay').hidden=false;document.body.style.overflow='hidden';labels();renderQuestion();startTimer();resizeFrog();talk(phrase("start"));}
function close(){stop();$('quizOverlay').hidden=true;document.body.style.overflow='';}
$('openQuiz').onclick=()=>{start();window.scrollTo(0,0);};$('closeQuiz').onclick=close;$('quizNext').onclick=next;document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('quizOverlay').hidden)close();});$('languagePicker').addEventListener('change',labels);labels();
})();
</script><script>

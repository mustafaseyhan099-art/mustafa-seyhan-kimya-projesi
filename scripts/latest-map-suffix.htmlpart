ı"],"Eskişehir":["Bor mineralleri, lületaşı","Bor (B), magnezyum (Mg)","borat ve sepiyolit"],"Gaziantep":["Bazalt","Silisyum (Si), demir (Fe)","volkanik kayaç"],"Giresun":["Bakır, kurşun-çinko cevherleri","Bakır (Cu), kurşun (Pb), çinko (Zn)","metal cevherleri"],"Gümüşhane":["Altın, gümüş cevherleri","Altın (Au), gümüş (Ag)","metal cevherleri"],"Hakkâri":["Kurşun-çinko cevherleri","Kurşun (Pb), çinko (Zn)","metal cevherleri"],"Hatay":["Demir cevheri","Demir (Fe)","metal cevheri"],"Iğdır":["Kaya tuzu","Sodyum (Na), klor (Cl)","halit minerali"],"Isparta":["Pomza, mermer","Silisyum (Si), kalsiyum (Ca)","kayaç ve doğal taş"],"İstanbul":["Kum, kil, kireçtaşı","Silisyum (Si), alüminyum (Al), kalsiyum (Ca)","yapı hammaddeleri"],"İzmir":["Altın cevheri, perlit","Altın (Au), silisyum (Si)","cevher ve volkanik cam"],"Kahramanmaraş":["Demir cevheri","Demir (Fe)","metal cevheri"],"Karabük":["Dolomit, kireçtaşı","Kalsiyum (Ca), magnezyum (Mg)","endüstriyel kayaç"],"Karaman":["Mermer","Kalsiyum (Ca)","doğal taş"],"Kars":["Bazalt","Silisyum (Si), demir (Fe)","volkanik kayaç"],"Kastamonu":["Bakır cevheri","Bakır (Cu)","metal cevheri"],"Kayseri":["Pomza","Silisyum (Si), oksijen (O)","volkanik kayaç"],"Kırıkkale":["Demir cevheri","Demir (Fe)","metal cevheri"],"Kırklareli":["Kuvars kumu, kalker","Silisyum (Si), kalsiyum (Ca)","endüstriyel hammadde"],"Kırşehir":["Florit","Kalsiyum (Ca), flor (F)","florür minerali"],"Kilis":["Kireçtaşı","Kalsiyum (Ca), karbon (C)","kayaç"],"Kocaeli":["Kireçtaşı","Kalsiyum (Ca), karbon (C)","kayaç"],"Konya":["Boksit, linyit","Alüminyum (Al), karbon (C)","cevher ve fosil yakıt"],"Kütahya":["Bor mineralleri, manyezit","Bor (B), magnezyum (Mg)","borat ve karbonat minerali"],"Malatya":["Demir cevheri","Demir (Fe)","metal cevheri"],"Manisa":["Nikel cevheri, linyit","Nikel (Ni), karbon (C)","cevher ve fosil yakıt"],"Mardin":["Fosfat kayacı","Fosfor (P), kalsiyum (Ca)","fosfat mineralleri"],"Mersin":["Kromit","Krom (Cr)","metal cevheri"],"Muğla":["Feldspat, kromit","Potasyum (K), krom (Cr)","mineral ve cevher"],"Muş":["Pomza","Silisyum (Si), oksijen (O)","volkanik kayaç"],"Nevşehir":["Pomza, perlit","Silisyum (Si), oksijen (O)","volkanik kayaç ve cam"],"Niğde":["Kalsit","Kalsiyum (Ca), karbon (C)","karbonat minerali"],"Ordu":["Bentonit","Alüminyum (Al), silisyum (Si)","kil minerali"],"Osmaniye":["Demir cevheri","Demir (Fe)","metal cevheri"],"Rize":["Bakır-çinko cevherleri","Bakır (Cu), çinko (Zn)","metal cevherleri"],"Sakarya":["Kum, kil","Silisyum (Si), alüminyum (Al)","yapı hammaddeleri"],"Samsun":["Bakır cevheri","Bakır (Cu)","metal cevheri"],"Siirt":["Bakır cevheri","Bakır (Cu)","metal cevheri"],"Sinop":["Kil, kalker","Alüminyum (Al), kalsiyum (Ca)","endüstriyel hammaddeler"],"Sivas":["Demir cevheri, jips","Demir (Fe), kalsiyum (Ca), kükürt (S)","cevher ve alçı taşı"],"Şanlıurfa":["Kireçtaşı","Kalsiyum (Ca), karbon (C)","kayaç"],"Şırnak":["Asfaltit","Karbon (C)","organik kökenli fosil hammadde"],"Tekirdağ":["Linyit","Karbon (C)","fosil yakıt"],"Tokat":["Bakır cevheri","Bakır (Cu)","metal cevheri"],"Trabzon":["Bakır-çinko cevherleri","Bakır (Cu), çinko (Zn)","metal cevherleri"],"Tunceli":["Kromit","Krom (Cr)","metal cevheri"],"Uşak":["Altın cevheri","Altın (Au)","metal cevheri"],"Van":["Pomza","Silisyum (Si), oksijen (O)","volkanik kayaç"],"Yalova":["Kireçtaşı","Kalsiyum (Ca), karbon (C)","kayaç"],"Yozgat":["Uranyum cevheri","Uranyum (U)","maden yatağı örneği"],"Zonguldak":["Taş kömürü","Karbon (C)","fosil yakıt"]};

const plateNames="Adana|Adıyaman|Afyonkarahisar|Ağrı|Amasya|Ankara|Antalya|Artvin|Aydın|Balıkesir|Bilecik|Bingöl|Bitlis|Bolu|Burdur|Bursa|Çanakkale|Çankırı|Çorum|Denizli|Diyarbakır|Edirne|Elazığ|Erzincan|Erzurum|Eskişehir|Gaziantep|Giresun|Gümüşhane|Hakkâri|Hatay|Isparta|Mersin|İstanbul|İzmir|Kars|Kastamonu|Kayseri|Kırklareli|Kırşehir|Kocaeli|Konya|Kütahya|Malatya|Manisa|Kahramanmaraş|Mardin|Muğla|Muş|Nevşehir|Niğde|Ordu|Rize|Sakarya|Samsun|Siirt|Sinop|Sivas|Tekirdağ|Tokat|Trabzon|Tunceli|Şanlıurfa|Uşak|Van|Yozgat|Zonguldak|Aksaray|Bayburt|Karaman|Kırıkkale|Batman|Şırnak|Bartın|Ardahan|Iğdır|Yalova|Karabük|Kilis|Osmaniye|Düzce".split('|');
const norm=t=>String(t||'').toLocaleLowerCase('tr-TR').replace(/[âîû]/g,c=>({'â':'a','î':'i','û':'u'}[c])).replace(/[^a-zçğıöşü]/g,'');
const plateOf=f=>{const v=Number(f.properties.plaka||f.properties.plate||f.properties.plate_no);if(v>=1&&v<=81)return v;return plateNames.findIndex(n=>norm(n)===norm(name(f)))+1};
const family=(z)=>{
 if([2,10,18,36,54,86,118].includes(z))return ['Soygazlar','#9b75e8'];
 if([9,17,35,53,85,117].includes(z))return ['Halojenler','#ee799b'];
 if([3,11,19,37,55,87].includes(z))return ['Alkali metaller','#f2a456'];
 if([4,12,20,38,56,88].includes(z))return ['Toprak alkali metaller','#edcc68'];
 if(z>=57&&z<=71)return ['Lantanitler','#55c5b7'];
 if(z>=89&&z<=103)return ['Aktinitler','#c99b75'];
 if([5,14,32,33,51,52,84].includes(z))return ['Yarı metaller','#8ecb70'];
 if([1,6,7,8,15,16,34].includes(z))return ['Ametal','#4bb7e8'];
 if([13,31,49,50,81,82,83,113,114,115,116].includes(z))return ['Diğer metaller','#8ba9f0'];
 if(z>=21&&z<=30||z>=39&&z<=48||z>=72&&z<=80||z>=104&&z<=112)return ['Geçiş metalleri','#6da6de'];
 return ['Diğer elementler','#b1b5c4'];
};
const atoms=typeof elements!=='undefined'?elements:[];
const section=document.getElementById('turkiyeMap');
const shell=section.querySelector('.tr-map-shell');
const toolbar=section.querySelector('.tr-map-tabs');
const fullscreen=document.createElement('button');fullscreen.type='button';fullscreen.id='trFull';fullscreen.textContent='⛶ Tam ekran harita';toolbar.appendChild(fullscreen);
const extras=document.createElement('div');extras.id='trExtras';shell.appendChild(extras);
const legend=document.createElement('div');legend.id='trFamilyLegend';shell.insertBefore(legend,document.querySelector('.tr-map-layout'));
const groups=[...new Map(atoms.map(e=>family(e[2])).map(a=>[a[0],a[1]])).entries()];
groups.forEach(([n,c])=>{const b=document.createElement('span');b.innerHTML='<i style="background:'+c+'"></i>'+n;legend.appendChild(b)});
function openAtom(i){const select=document.getElementById('element');if(select){select.value=String(i);select.dispatchEvent(new Event('change'))}const btn=document.getElementById('startLab');if(btn)btn.click()}
function atom(e,i,city=''){const f=family(e[2]);info.replaceChildren();const h=document.createElement('h3');h.textContent=e[2]+'. '+e[1]+' ('+e[0]+')';info.appendChild(h);const a=document.createElement('p');a.textContent=(city?'Plaka '+String(e[2]).padStart(2,'0')+' · '+city+' → ':'')+f[0];info.appendChild(a);const b=document.createElement('p');b.textContent='Atom numarası: '+e[2]+' · Proton: '+e[2]+' · Nötr atomda elektron: '+e[2];info.appendChild(b);}
function pointInRing(x,y,ring){let inside=false;for(let i=0,j=ring.length-1;i<ring.length;j=i++){const a=ring[i],b=ring[j];if(((a[1]>y)!==(b[1]>y))&&(x<(b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0]))inside=!inside}return inside}
function distEdge(x,y,ring){let best=Infinity;for(let i=0;i<ring.length;i++){const a=ring[i],b=ring[(i+1)%ring.length],dx=b[0]-a[0],dy=b[1]-a[1];const t=Math.max(0,Math.min(1,((x-a[0])*dx+(y-a[1])*dy)/(dx*dx+dy*dy||1)));best=Math.min(best,Math.hypot(x-a[0]-t*dx,y-a[1]-t*dy))}return best}
function center(f){let ring=[];for(const poly of rings(f.geometry)){const r=poly[0]||[];if(r.length>ring.length)ring=r}if(!ring.length)return[0,0];const pts=ring.map(xy),xs=pts.map(p=>p[0]),ys=pts.map(p=>p[1]);const x0=Math.min(...xs),x1=Math.max(...xs),y0=Math.min(...ys),y1=Math.max(...ys);let best=[(x0+x1)/2,(y0+y1)/2],score=-1;for(let step=7;step>=.9;step/=2){const bx=score<0?x0:best[0]-step*5,ex=score<0?x1:best[0]+step*5,by=score<0?y0:best[1]-step*5,ey=score<0?y1:best[1]+step*5;for(let y=by;y<=ey;y+=step)for(let x=bx;x<=ex;x+=step){if(!pointInRing(x,y,pts))continue;const d=distEdge(x,y,pts);if(d>score){score=d;best=[x,y]}}}return best}
let selectedPlate=0;
const glowDefs=el('defs',{},svg);const glow=el('filter',{id:'provinceGlow',x:'-80%',y:'-80%',width:'260%',height:'260%'},glowDefs);el('feGaussianBlur',{in:'SourceGraphic',stdDeviation:'3',result:'blur'},glow);const merge=el('feMerge',{},glow);el('feMergeNode',{in:'blur'},merge);el('feMergeNode',{in:'SourceGraphic'},merge);
function selectPlate(z,showInfo=true){selectedPlate=z;render();const f=features.find(x=>plateOf(x)===z),e=atoms[z-1];if(showInfo&&e)atom(e,z-1,f?name(f):'');if(f){const p=document.querySelector('[data-plate="'+z+'"]');if(p)p.scrollIntoView({block:'nearest',inline:'nearest'})}}
function render(){
 layer.replaceChildren();if(!features.length)return;
 const raw=search.value.trim();const q=norm(raw);const numeric=/^\d+$/.test(raw);
 features.forEach(f=>{
  const z=plateOf(f);if(z<1||z>81)return;
  const e=atoms[z-1];if(!e)return;
  const city=name(f),fam=family(z);
  const match=!raw||(numeric?String(z)===raw:[city,e[0],e[1]].some(t=>norm(t).includes(q)));
  const selected=selectedPlate===z;
  const group=el('g',{'data-plate':z,class:selected?'tr-province selected':'tr-province',opacity:match?1:.24});
  const path=el('path',{d:shape(f),fill:fam[1],stroke:selected?'#fff4a3':'#10243e','stroke-width':selected?2.5:.8,'fill-rule':'evenodd',role:'button',tabindex:0,'aria-label':city+', '+e[1]+', '+z},group);
  path.style.cursor='pointer';group.addEventListener('click',()=>selectPlate(z));path.addEventListener('keydown',ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();selectPlate(z)}});
  const [x,y]=center(f);const g=el('g',{'pointer-events':'none'},group);
  const text=el('text',{x,y,'text-anchor':'middle','dominant-baseline':'middle','font-size':e[1].length>11?5:6.2,'font-weight':'800',fill:'#07152a',stroke:'#e9f6ff','stroke-width':'.6','paint-order':'stroke'},g);
  const t1=el('tspan',{x,dy:'-2.5'},text);t1.textContent=e[1];
  const t2=el('tspan',{x,dy:'7','font-size':'5.4'},text);t2.textContent=z+' · '+e[0];
 });
 
}
function renderExtras(){
 extras.replaceChildren();
 const h=document.createElement('h3');h.textContent='82–118 · Harita dışındaki elementler';extras.appendChild(h);
 const p=document.createElement('p');p.textContent='Türkiye’de 82–118 numaralı plakalar bulunmadığından bu 37 element haritanın altında gösterilir.';extras.appendChild(p);
 const grid=document.createElement('div');grid.className='tr-extra-grid';extras.appendChild(grid);
 atoms.slice(81).forEach((e,i)=>{const f=family(e[2]);const b=document.createElement('button');b.type='button';b.className='tr-extra-element';b.style.setProperty('--element-color',f[1]);b.innerHTML='<strong>'+e[2]+' · '+e[0]+'</strong><span>'+e[1]+'</span>';b.title=f[0];b.onclick=()=>atom(e,i+81);grid.appendChild(b)});
}
function setMode(m){
 mode=m;tabE.classList.toggle('active',m==='elements');tabC.classList.toggle('active',m==='cities');
 search.value='';search.placeholder='İl, element, sembol veya atom numarası ara…';
 selectedPlate=0;info.innerHTML='<h3>🇹🇷 Plaka = Atom numarası</h3><p>Bir ilin üzerine tıklayarak elementini ve grubunu incele. Aynı gruptaki elementlerin illeri aynı renkte gösterilir.</p>';
 render();renderExtras();
}
tabE.textContent='⚛ Plaka–Element Haritası';tabC.textContent='📍 81 İl';
tabE.onclick=()=>setMode('elements');tabC.onclick=()=>setMode('cities');search.oninput=()=>{
 const raw=search.value.trim();
 if(!raw){selectedPlate=0;render();return}
 const numeric=/^\d+$/.test(raw);
 let z=0;
 if(numeric){const value=Number(raw);if(value>=1&&value<=81)z=value}
 else {const q=norm(raw);if(q){const f=features.find(f=>{const n=plateOf(f),e=atoms[n-1];return e&&[name(f),e[0],e[1]].some(t=>norm(t).includes(q))});if(f)z=plateOf(f)}}
 selectedPlate=z;
 render();
 if(z){const f=features.find(f=>plateOf(f)===z);atom(atoms[z-1],z-1,name(f))}
};
document.getElementById('trMapToLab').onclick=()=>document.getElementById('startLab').click();
document.getElementById('trMapHome').onclick=()=>{section.classList.remove('tr-fullscreen');document.body.classList.remove('tr-map-open');document.getElementById('goHome').click()};
function toggleFull(on){section.classList.toggle('tr-fullscreen',on);document.body.classList.toggle('tr-map-open',on);fullscreen.textContent=on?'✕ Haritadan çık':'⛶ Tam ekran harita';if(on)section.scrollIntoView({block:'start'})}
fullscreen.onclick=()=>toggleFull(!section.classList.contains('tr-fullscreen'));
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&section.classList.contains('tr-fullscreen'))toggleFull(false)});
svg.setAttribute('viewBox','15 12.5 770 395');svg.setAttribute('preserveAspectRatio','xMidYMid meet');svg.querySelectorAll('polygon').forEach(e=>e.remove());
if(__features.length!==81)throw Error('Harita sınırları eksik');
features=__features;
setMode('elements');
if(layer.querySelectorAll('path').length!==81)console.warn('İl sayısı beklendiği gibi değil',layer.querySelectorAll('path').length);
// Enter full screen only when user clicks the map; keep home screen visible at first opening.

})();
</script></body></html>
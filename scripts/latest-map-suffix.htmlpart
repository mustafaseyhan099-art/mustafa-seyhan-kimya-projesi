const __plateNames='Adana|Adıyaman|Afyonkarahisar|Ağrı|Amasya|Ankara|Antalya|Artvin|Aydın|Balıkesir|Bilecik|Bingöl|Bitlis|Bolu|Burdur|Bursa|Çanakkale|Çankırı|Çorum|Denizli|Diyarbakır|Edirne|Elazığ|Erzincan|Erzurum|Eskişehir|Gaziantep|Giresun|Gümüşhane|Hakkâri|Hatay|Isparta|Mersin|İstanbul|İzmir|Kars|Kastamonu|Kayseri|Kırklareli|Kırşehir|Kocaeli|Konya|Kütahya|Malatya|Manisa|Kahramanmaraş|Mardin|Muğla|Muş|Nevşehir|Niğde|Ordu|Rize|Sakarya|Samsun|Siirt|Sinop|Sivas|Tekirdağ|Tokat|Trabzon|Tunceli|Şanlıurfa|Uşak|Van|Yozgat|Zonguldak|Aksaray|Bayburt|Karaman|Kırıkkale|Batman|Şırnak|Bartın|Ardahan|Iğdır|Yalova|Karabük|Kilis|Osmaniye|Düzce'.split('|');
function __decodeCoords(code){const a=[];for(let i=0;i+3<code.length;i+=4){const x=__alphabet.indexOf(code[i])*64+__alphabet.indexOf(code[i+1]);const y=__alphabet.indexOf(code[i+2])*64+__alphabet.indexOf(code[i+3]);a.push([25+x/100,34+y/100])}return a}
const __features=__offlineProvinceData.split(';').map((s,i)=>({type:'Feature',properties:{plaka:i+1,il_adi:__plateNames[i]},geometry:{type:'MultiPolygon',coordinates:s.split('!').filter(Boolean).map(poly=>poly.split('|').filter(Boolean).map(__decodeCoords))}}));

// Actual province boundary coordinates; never use a schematic fallback.
const xy=([lon,lat])=>[(lon-25.5)*38+22,(42.6-lat)*52+12];
function el(tag,attrs,parent=layer){const n=document.createElementNS(NS,tag);Object.entries(attrs).forEach(([k,v])=>n.setAttribute(k,v));parent.appendChild(n);return n}
function rings(geometry){if(!geometry)return[];return geometry.type==='Polygon'?[geometry.coordinates]:geometry.type==='MultiPolygon'?geometry.coordinates:[]}
function shape(f){return rings(f.geometry).map(poly=>poly.map(ring=>ring.map(p=>{const [x,y]=xy(p);return x.toFixed(1)+','+y.toFixed(1)}).join(' ')).map((pts,i)=>'M'+pts.replaceAll(' ','L')+'Z').join(' ')).join(' ')}
function name(f){return f.properties.il_adi||f.properties.name||f.properties.NAME_1||'İl'}
